{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:monorepos"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Batch all non-major npm updates into one weekly PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "description": "Keep GitHub Actions current",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Docker base images (node, nginx, postgres)",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images"
    },
    {
      "description": "Stay on Node LTS (even) majors in Docker images",
      "matchDepNames": ["node"],
      "matchManagers": ["dockerfile"],
      "allowedVersions": "/^\\d*[02468](-|\\.|$)/"
    }
  ]
}
